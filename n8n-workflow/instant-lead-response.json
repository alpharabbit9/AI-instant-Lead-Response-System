        "subject": "={{ \"Still looking for a \" + $('Normalize Data').item.json.property + \" in \" + $('Normalize Data').item.json.location + \"?\" }}",
        "emailType": "text",
        "message": "={{ \"Dear \" + $('Normalize Data').item.json.name + \",\\n\\nI wanted to follow up on your enquiry for a \" + $('Normalize Data').item.json.property + \" in \" + $('Normalize Data').item.json.location + \" within a budget of \" + $('Normalize Data').item.json.budget + \".\\n\\nWe have been shortlisting options that match your criteria and would love to arrange a viewing at your convenience. A few questions that might help us narrow things down:\\n\\n• Are you flexible on location within \" + $('Normalize Data').item.json.location + \"?\\n• Is your timeline urgent or are you exploring options?\\n• Do you have any specific requirements we should know about?\\n\\nSimply reply to this email or call us directly — we are ready to help.\\n\\nWarm regards,\\nReal Estate Team\" }}",
        "options": {
