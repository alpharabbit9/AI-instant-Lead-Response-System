    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"llama-3.3-70b-versatile\", \"temperature\": 0.7, \"max_tokens\": 1000, \"response_format\": { \"type\": \"json_object\" }, \"messages\": [ { \"role\": \"system\", \"content\": \"You are an expert real estate lead analyst. Analyze the inquiry and return ONLY a valid JSON object with exactly these fields:\\n- lead_score: integer 0-100 (qualification score based on budget, clarity, and intent)\\n- intent: exactly one of buy, rent, or invest\\n- summary: 1-2 sentences describing the buyer's needs and urgency\\n- urgency: exactly one of high, medium, or low\\n- reply_email: a warm professional 3-paragraph email. Paragraph 1: thank them by name and acknowledge their specific request. Paragraph 2: confirm you are working on curated options for their budget and location. Paragraph 3: let them know an agent will follow up within 24 hours and invite questions.\\nDo NOT include any text outside the JSON object.\" }, { \"role\": \"user\", \"content\": \"Name: \" + $json.name + \"\\nEmail: \" + $json.email + \"\\nProperty: \" + $json.property + \"\\nBudget: \" + $json.budget + \"\\nLocation: \" + $json.location + \"\\nMessage: \" + ($json.message || \"No additional details provided.\") } ] } }}",
        "options": {}
      },
      "id": "c9bafa42-19ea-42d0-b2c6-e90e7940d2d8",
      "name": "Groq AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [912, 304],
      "credentials": {
        "httpBearerAuth": {
          "id": "XaOV2uvD8688bN2t",
          "name": "Bearer Auth account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let parsed;\ntry {\n  const content = $input.item.json.choices[0].message.content;\n  const clean = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  // Fallback if AI returns bad JSON\n  const d = $('Normalize Data').item.json;\n  parsed = {\n    lead_score: 50,\n    intent: 'buy',\n    urgency: 'medium',\n    summary: 'Buyer inquiry received. Manual review recommended.',\n    reply_email: `Dear ${d.name},\\n\\nThank you for reaching out about your property search. We have received your inquiry for a ${d.property} in ${d.location} within a budget of ${d.budget}.\\n\\nOur team is reviewing your requirements and preparing curated options that match your criteria.\\n\\nOne of our specialist agents will be in touch within 24 hours. Please don't hesitate to reply with any questions.\\n\\nWarm regards,\\nReal Estate Team`\n  };\n}\nreturn { ...parsed };"
      },
      "id": "741386ac-456c-4539-a325-8d50fb988a5c",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1136, 304]
    },
